# Copy this file's variables into your real environment (a local .env you
# source yourself, or your host's environment variable settings — e.g.
# Railway's Variables tab). This file is a template only; config.py reads
# these from the process environment, not from this file directly.

# Required. Every request to /api/* must send this value as the X-API-Key
# header (or an api_key query parameter). With this unset, the API refuses
# every request rather than running wide open.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
HYPERVIS_API_KEY=

# Required for any real deployment. Comma-separated list of exact origins
# (scheme + host + port) allowed to call this API from a browser. Defaults to
# localhost dev origins only if unset. Example:
# HYPERVIS_ALLOWED_ORIGINS=https://your-dashboard.up.railway.app,http://localhost:5173
HYPERVIS_ALLOWED_ORIGINS=

# Optional. Path to the per-camera profile/zone config file. Defaults to
# config/cameras.json inside the project.
# HYPERVIS_CAMERA_CONFIG=/path/to/cameras.json
